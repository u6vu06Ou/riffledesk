{
  "manifest_version": 3,
  "name": "RiffleDesk Tabs Bridge",
  "version": "0.4.1",
  "description": "Pushes your open tabs to the local RiffleDesk file browser (127.0.0.1) so they show up as cards. Nothing leaves the machine.",
  "browser_specific_settings": {
    "gecko": {
      "id": "riffledesk-tabs@u6vu06Ou",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["tabs", "scripting", "storage", "alarms", "idle", "sessions"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["defaults.js", "i18n.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["defaults.js", "i18n.js", "drawer.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "icons/icon-32.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "RiffleDesk"
  },
  "icons": { "32": "icons/icon-32.png", "128": "icons/icon-128.png" },
  "commands": {
    "focus-riffledesk": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "把開著的 RiffleDesk 帶到前景（沒開就開一個）"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:*/; connect-src http://127.0.0.1:*/"
  }
}
